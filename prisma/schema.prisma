generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Chassis models (S1) go here, above the tool markers.

// ── tool:kyc-review ──

// ── tool:refunds ──

// ── tool:feature-flags ──

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  enabled     Boolean
  environment String // one of: dev, staging, prod
  rollout     Int // percentage of traffic, 0-100
  updatedAt   DateTime @updatedAt
}

model FeatureFlagChangeRequest {
  id               String    @id @default(cuid())
  flagId           String
  requestedEnabled Boolean
  reason           String
  status           String // one of: pending, approved, rejected
  requestedById    String
  requestedByName  String
  requestedByRole  String
  decidedById      String?
  decidedByName    String?
  createdAt        DateTime  @default(now())
  decidedAt        DateTime?
}

model FeatureFlagAudit {
  id        String   @id @default(cuid())
  event     String // one of: change_requested, change_approved, change_rejected, flag.emergency_off
  flagId    String
  requestId String?
  actorId   String
  actorName String
  actorRole String
  reason    String?
  createdAt DateTime @default(now())
}
